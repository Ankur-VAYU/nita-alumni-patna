{
  "name": "nita-alumni-patna-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the NIT Agartala Alumni Patna Chapter app: join form, member accounts, admin tools",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "cli:prod": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli.ts migrate",
    "cli": "tsx src/cli.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "set-db": "node scripts/set-database-url.mjs",
    "show-env": "node scripts/show-env.mjs",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "prebuild": "node scripts/gen-migrations.mjs",
    "predeploy": "node scripts/gen-migrations.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
