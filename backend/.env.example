NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Where the database lives. This one URL decides where all member data is stored.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nita_alumni

# Key for the admin API and admin tools. Make it long and random, and keep it secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string-at-least-32-chars


# Only for docker-compose.yml (production on one server):
# Database password (long and random) and the web address people will open.
POSTGRES_PASSWORD=change-me-long-random-password
DOMAIN=join.example.org

# Sign in with Google (optional for local development). See DEPLOY.md, "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
